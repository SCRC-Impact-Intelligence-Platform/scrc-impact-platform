# SQL Server connection URL (required).
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=mssql+pyodbc://user:password@host:1433/scrc_impact?driver=ODBC+Driver+18+for+SQL+Server

# Copy to backend/.env (git-ignored). Only enable authorized testing.
SMTP_HOST=mta.service.uci.edu
SMTP_PORT=587
SMTP_FROM=DoNotReply@uci.edu
SMTP_ENABLE_SEND=false
SMTP_ALLOWED_RECIPIENTS=your-controlled-test-address@uci.edu
